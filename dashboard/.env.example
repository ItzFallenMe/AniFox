# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
NEXTAUTH_URL="http://localhost:3000"

DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""

# ── Bot API ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
NEXT_PUBLIC_DASHBOARD_API_KEY="change-me"

# ── Branding ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BRAND_NAME="Alpha"

# ── Public Links ──────────────────────────────────────────────────────────────
# Every support/invite/docs link shown on the dashboard comes from here.
NEXT_PUBLIC_SUPPORT_SERVER_URL="https://discord.gg/your-support-invite"
NEXT_PUBLIC_BOT_INVITE_URL="https://discord.com/oauth2/authorize?client_id=YOUR_BOT_ID&permissions=8&scope=bot+applications.commands"
NEXT_PUBLIC_WEBSITE_URL="https://your-website.com"
NEXT_PUBLIC_GITHUB_URL="https://github.com/YourName/YourBot"
NEXT_PUBLIC_DOCS_URL="/docs"
NEXT_PUBLIC_VOTE_URL="https://top.gg/bot/YOUR_BOT_ID/vote"
