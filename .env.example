# One local environment file for the AniFox web client, shared API and Flutter builds.
# Copy to .env and set values you use. Never commit the populated file.

# Root URL of the website deployment that hosts the shared /api routes.
# For Flutter on a local Android emulator, use http://10.0.2.2:3000 instead.
ANIFOX_API_URL=http://localhost:3000

# Metadata and tracking integrations (Flutter --dart-define values where used).
TMDB_API_KEY=
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
SIMKL_CLIENT_ID=
SIMKL_CLIENT_SECRET=
RELEASE_REPO=ItzFallenMe/AniFox

# Server-side secrets/configuration. Do not pass these to Flutter builds.
MANGADEX_API_URL=https://api.mangadex.org
# Streamrip provides test pages using the route templates documented below.
# Replace this with a provider you are authorized to use for production.
DOWNLOAD_PROVIDER_URL=https://streamrip.fun

# Public Discord application ID; set it in Discord Developer Portal first.
DISCORD_APPLICATION_ID=

# Optional Google Cast receiver application ID for the web client.
NEXT_PUBLIC_CAST_RECEIVER_APP_ID=
