# Server-only TMDB API key (v3 API key or v4 read token).
TMDB_API_KEY=your_tmdb_api_key

# Optional: deployed AniFox Manga API root URL; do not append /api.
MANGA_API_URL=https://your-manga-api.vercel.app

# Optional: Chromecast receiver application id (see /cast). Cast is hidden
# from the player when this is unset.
NEXT_PUBLIC_CAST_RECEIVER_APP_ID=
