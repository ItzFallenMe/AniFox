# Server-only TMDB API key (v3 API key or v4 read token).
TMDB_API_KEY=your_tmdb_api_key

# Optional: deployed AniFox Manga API root URL; do not append /api.
MANGA_API_URL=https://your-manga-api.vercel.app

# Optional: Chromecast receiver application id (see /cast).
NEXT_PUBLIC_CAST_RECEIVER_APP_ID=

# Optional: streaming source used by the player. When set, it is listed first
# and used by default. Expected routes:
#   /movie/{tmdbId}
#   /tv/{tmdbId}/{season}/{episode}
#   /anime/{anilistId}/{episode}
NEXT_PUBLIC_STREAM_API_URL=

# Optional: licensed download provider. The provider is embedded by domain and
# expects these routes (no key):
#   /movie/{tmdbId}
#   /tv/{tmdbId}/{season}/{episode}
#   /anime/{anilistId}/{episode}
NEXT_PUBLIC_DOWNLOAD_URL=
